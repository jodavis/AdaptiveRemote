@if (IsListening)
{
    <div class="conversation-border"><div></div></div>
}

@if (SpeakingMessage is not null)
{
    <div class="conversation-speaking-message"><span>"@SpeakingMessage"</span></div>
}

@if (ToggleListening is not null)
{
    <div class="conversation-status-message clickable" @onclick="@ToggleListening">@StatusMessage</div>
}
else 
{
    <div class="conversation-status-message">@StatusMessage</div>
}

@code {
    [Parameter]
    public Models.ConversationView? ViewModel { get; set; }

    private bool IsListening => ViewModel?.IsListening ?? false;
    private string? StatusMessage => ViewModel?.StatusMessage;
    private string? SpeakingMessage => ViewModel?.SpeakingMessage;
    private Action? ToggleListening => ViewModel?.ToggleListening;

    protected override void OnInitialized()
    {
        if (ViewModel is not null)
        {
            ViewModel.PropertyChanged += (sender, args) => InvokeAsync(StateHasChanged);
        }

        base.OnInitialized();
    }
}
