<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;linux-x64;osx-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AdaptiveRemote.Electron</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdaptiveRemote.App\AdaptiveRemote.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ElectronNET.Core" Version="0.2.0" />
    <PackageReference Include="ElectronNET.Core.AspNet" Version="0.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  </ItemGroup>
</Project>