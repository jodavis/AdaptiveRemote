@inherits Mvvm.MvvmComponent<Models.LifecycleView>
@inject Models.LifecycleView RootViewModel;
@inject BlazorAppScope AppScope;

@if (ViewModel?.CurrentPhase == LifecyclePhase.Ready)
{
    <Remote ProgramMode="@ViewModel.IsProgrammingMode" />
}
else
{
    <LoadingScreen ViewModel="@ViewModel" />
}

@code
{
    protected override void OnInitialized()
    {
        ViewModel = RootViewModel;

        base.OnInitialized();
    }
}