@inject Models.LifecycleView ViewModel;
@inject BlazorAppScope AppScope;
@inject Services.Layout.IDynamicStylesheetProvider DynamicStylesheet;

@if (DynamicStylesheet.GetCss() is { } css)
{
    <style>@((MarkupString)css)</style>
}

@if (ViewModel.CurrentPhase == LifecyclePhase.Ready)
{
    <Remote ProgramMode="@ViewModel.IsProgrammingMode" />
}
else
{
    <LoadingScreen />
}

@code
{
    protected override void OnInitialized()
    {
        ViewModel.PropertyChanged += (sender, args) => InvokeAsync(StateHasChanged);

        base.OnInitialized();
    }
}