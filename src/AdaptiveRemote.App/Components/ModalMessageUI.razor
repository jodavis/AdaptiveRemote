@inject Models.ModalMessageView ModalViewModel
@implements IDisposable

@if (CurrentMessage is not null)
{
    <div class="conversation-speaking-message"><span>"@CurrentMessage"</span></div>
}

@code {
    private string? CurrentMessage => ModalViewModel?.CurrentMessage;

    protected override void OnInitialized()
    {
        if (ModalViewModel is not null)
        {
            ModalViewModel.PropertyChanged += OnModalViewModelPropertyChanged;
        }

        base.OnInitialized();
    }

    private void OnModalViewModelPropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs args)
        => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        if (ModalViewModel is not null)
        {
            ModalViewModel.PropertyChanged -= OnModalViewModelPropertyChanged;
        }
    }
}
