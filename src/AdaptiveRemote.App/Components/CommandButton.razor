@inherits CommandButtonBase

<button class="@CssClasses" id="@ID" disabled=@(!IsEnabled) @onclick="Invoke">@Label</button>

@code {
    protected override bool IsEnabled => ViewModel?.ExecuteAsync is not null && ViewModel?.IsEnabled == true;

    protected override void Invoke()
    {
        ViewModel?.ExecuteAsync?.Invoke(default);
    }
}
