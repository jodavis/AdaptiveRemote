@inject Models.LifecycleView LifecycleView
@implements IDisposable

@switch (LayoutElement)
{
    case Models.Command command:
        @if (LifecycleView.IsProgrammingMode)
        {
            <ProgramButton Command="@command" />
        }
        else
        {
            <CommandButton Command="@command" />
        }
        break;
    case Models.LayoutGroup nestedGroup:
        <div id="@nestedGroup.CSSID">
            @foreach (Models.RemoteLayoutElement element in nestedGroup.Elements)
            {
                <RemoteLayout LayoutElement="@element" />
            }
        </div>
        break;
    case Models.ConversationView conversation:
        <ConversationUI ViewModel="@conversation" />
        break;
}

@code {
    private System.ComponentModel.PropertyChangedEventHandler? _propertyChangedHandler;

    [Parameter]
    public Models.RemoteLayoutElement? LayoutElement { get; set; }

    protected override void OnInitialized()
    {
        _propertyChangedHandler = (sender, args) => InvokeAsync(StateHasChanged);
        LifecycleView.PropertyChanged += _propertyChangedHandler;
        base.OnInitialized();
    }

    public void Dispose()
    {
        if (_propertyChangedHandler is not null)
        {
            LifecycleView.PropertyChanged -= _propertyChangedHandler;
        }
    }
}
