@inherits CommandButtonBase
@inject Models.LifecycleView LifecycleView

<button class="@CssClasses" id="@ID" disabled=@(!IsEnabled) data-programmed="@IsProgrammed" @onclick="Invoke">@Label</button>

@code {
    protected override bool IsEnabled => Command?.ProgramAsync is not null;

    private string IsProgrammed => (Command?.IsEnabled ?? false).ToString();

    protected override void Invoke()
    {
        CancellationToken token = LifecycleView.ProgrammingCancellation?.Token ?? CancellationToken.None;
        Command?.ProgramAsync?.Invoke(token);
    }
}
