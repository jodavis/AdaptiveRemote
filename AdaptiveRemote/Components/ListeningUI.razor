@using Mvvm;
@inherits MvvmComponent
@inject Services.ISpeechController SpeechController

<div class="@(IsListening ? "listening-on" : "listening-off")">@StatusMessage</div>

@code {
    private static readonly MvvmProperty<bool> IsListeningProperty = new(nameof(IsListening));
    private static readonly MvvmProperty<string> StatusMessageProperty = new(nameof(StatusMessage));
    private static readonly MvvmProperty<Models.Listening?> ViewModelProperty = new(nameof(ViewModel));

    private IDisposable? _binding = null;
    private IDisposable? _binding2 = null;

#pragma warning disable BL0007
    [Parameter]
    public Models.Listening? ViewModel
    {
        get => GetValue(ViewModelProperty);
        set
        {
            _binding?.Dispose();
            _binding2?.Dispose();
            SetValue(ViewModelProperty, value);
            _binding = value is null ? null
                : Bind(IsListeningProperty, value, Models.Listening.IsListeningProperty);
            _binding2 = value is null ? null
                : Bind(StatusMessageProperty, value, Models.Listening.StatusMessageProperty);
        }
    }

    private bool IsListening
    {
        get => GetValue(IsListeningProperty);
        set => SetValue(IsListeningProperty, value);
    }

    private string StatusMessage
    {
        get => GetValue(StatusMessageProperty);
        set => SetValue(StatusMessageProperty, value);
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();

        SpeechController.Start();
    }
}
