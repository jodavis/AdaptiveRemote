@inject Models.LifecycleView ViewModel;

<div id="LifecycleTitle"><div>[ [ Adaptive Remote ] ]</div></div>
<div id="LifecycleTaskDescription">@ViewModel.TaskName</div>

@code
{
    protected override void OnInitialized()
    {
        ViewModel.PropertyChanged += (sender, args) => InvokeAsync(StateHasChanged);

        base.OnInitialized();
    }
}