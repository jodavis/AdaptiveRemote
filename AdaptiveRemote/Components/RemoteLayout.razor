@switch (LayoutElement)
{
    case Models.Command command:
        <CommandButton Command="@command" />
        break;
    case Models.LayoutGroup nestedGroup:
        <div id="@nestedGroup.CSSID">
            @foreach (Models.RemoteLayoutElement element in nestedGroup.Elements)
            {
                <RemoteLayout LayoutElement="@element" />
            }
        </div>
        break;
    case Models.Listening listening:
        <ListeningUI ViewModel="@listening" />
        break;
}

@code {
    [Parameter]
    public Models.RemoteLayoutElement? LayoutElement { get; set; }
}
