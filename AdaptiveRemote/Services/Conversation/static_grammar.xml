<?xml version="1.0" encoding="utf-8" ?>
<grammar version="1.0" xml:lang="en-US"
         xmlns="http://www.w3.org/2001/06/grammar"
         tag-format="semantics/1.0" root="Attention">

  <rule id="Attention" scope="public">
    <one-of>
      <item>Hey Remote</item>
      <item>Hey TV</item>
    </one-of>
    <tag>out="STARTLISTENING"</tag>
  </rule>

  <rule id="YesNo" scope="public">
    <one-of>
      <item>
        <one-of>
          <item>Yes</item>
          <item>Yes, please</item>
          <item>Yep</item>
          <item>Yeah</item>
        </one-of>
        <tag>out="YES"</tag>
      </item>
      <item>
        <one-of>
          <item>No</item>
          <item>Nah</item>
          <item>No, thank you</item>
        </one-of>
        <tag>out="NO"</tag>
      </item>
    </one-of>
  </rule>

  <rule id="Commands" scope="public">
    <one-of>
      <item>
        <ruleref uri="#Command"></ruleref>
      </item>
      <item>
        <ruleref uri="#Stop"></ruleref>
      </item>
    </one-of>
  </rule>

  <rule id="Command">
    <one-of>
      <item>
        <one-of>
          <item>Up</item>
          <item>Go up</item>
        </one-of>
        <tag>out="Command:Up"</tag>
      </item>
      <item>
        <one-of>
          <item>Down</item>
          <item>Go down</item>
        </one-of>
        <tag>out="Command:Down"</tag>
      </item>
      <item>
        <one-of>
          <item>Left</item>
          <item>Go left</item>
        </one-of>
        <tag>out="Command:Left"</tag>
      </item>
      <item>
        <one-of>
          <item>Right</item>
          <item>Go right</item>
        </one-of>
        <tag>out="Command:Right"</tag>
      </item>
      <item>
        <one-of>
          <item>Select</item>
          <item>OK</item>
        </one-of>
        <tag>out="Command:Select"</tag>
      </item>
      <item>
        <one-of>
          <item>TiVo</item>
          <item>Go to TiVo</item>
        </one-of>
        <tag>out="Command:TiVo"</tag>
      </item>
      <item>
        <one-of>
          <item>Guide</item>
          <item>Go to Guide</item>
        </one-of>
        <tag>out="Command:Guide"</tag>
      </item>
      <item>
        <one-of>
          <item>Netflix</item>
          <item>Go to Netflix</item>
        </one-of>
        <tag>out="Command:Netflix"</tag>
      </item>
      <item>
        <one-of>
          <item>Back</item>
          <item>Go back</item>
        </one-of>
        <tag>out="Command:Back"</tag>
      </item>
      <item>
        <one-of>
          <item>Play</item>
        </one-of>
        <tag>out="Command:Play"</tag>
      </item>
      <item>
        <one-of>
          <item>Pause</item>
        </one-of>
        <tag>out="Command:Pause"</tag>
      </item>
      <item>
        <one-of>
          <item>Record</item>
        </one-of>
        <tag>out="Command:Record"</tag>
      </item>
      <item>
        <one-of>
          <item>Replay</item>
          <item>Skip back</item>
        </one-of>
        <tag>out="Command:Replay"</tag>
      </item>
      <item>
        <one-of>
          <item>Advance</item>
          <item>Skip forward</item>
          <item>Skip</item>
        </one-of>
        <tag>out="Command:Skip"</tag>
      </item>
      <item>
        <one-of>
          <item>Channel up</item>
          <item>Page up</item>
        </one-of>
        <tag>out="Command:ChannelUp"</tag>
      </item>
      <item>
        <one-of>
          <item>Channel down</item>
          <item>Page down</item>
        </one-of>
        <tag>out="Command:ChannelDown"</tag>
      </item>
      <item>
        <one-of>
          <item>Louder</item>
          <item>Volume up</item>
        </one-of>
        <tag>out="Command:VolumeUp"</tag>
      </item>
      <item>
        <one-of>
          <item>Quieter</item>
          <item>Softer</item>
          <item>Volume down</item>
        </one-of>
        <tag>out="Command:VolumeDown"</tag>
      </item>
      <item>
        <one-of>
          <item>Mute</item>
        </one-of>
        <tag>out="Command:Mute"</tag>
      </item>
      <item>
        <one-of>
          <item>Exit</item>
          <item>Quit</item>
        </one-of>
        <tag>out="Command:Exit"</tag>
      </item>
    </one-of>
  </rule>

  <rule id="Stop">
    <one-of>
      <item>Stop Listening</item>
      <item>Done</item>
      <item>I'm Done</item>
      <item>Thank you</item>
    </one-of>
    <tag>out="STOPLISTENING"</tag>
  </rule>

  <rule id="Typing">
    Type <ruleref uri="grammar:dictation" type="application/srgs+xml" />
  </rule>
</grammar>