<?xml version="1.0" encoding="utf-8" ?>
<grammar version="1.0" xml:lang="en-US"
         xmlns="http://www.w3.org/2001/06/grammar"
         tag-format="semantics/1.0" root="WakeWord">

  <rule id="WakeWord" scope="public">
    <one-of>
      <item>Hey Remote</item>
    </one-of>
    <tag>out.system="STARTLISTENING"</tag>
  </rule>

  <rule id="Confirmation" scope="public">
    <one-of>
      <item>
        <one-of>
          <item>Yes</item>
          <item>Yes, please</item>
          <item>Yep</item>
          <item>Yeah</item>
        </one-of>
        <tag>out.system="YES"</tag>
      </item>
      <item>
        <one-of>
          <item>No</item>
          <item>Nah</item>
          <item>No, thank you</item>
        </one-of>
        <tag>out.system="NO"</tag>
      </item>
    </one-of>
  </rule>

  <rule id="Commands" scope="public">
    <one-of>
      <item>
        <ruleref uri="#Command"></ruleref>
      </item>
      <item>
        <ruleref uri="#RepeatableCommand"></ruleref>
      </item>
      <item>
        <ruleref uri="#Stop"></ruleref>
      </item>
    </one-of>
  </rule>

  <rule id="Correction" scope="public">
    <one-of>
      <item>That's wrong</item>
      <item>No, that's wrong</item>
    </one-of>
    <tag>out.correction="true"</tag>
  </rule>

  <rule id="Command">
    <one-of>
      <item>
        <one-of>
          <item>On</item>
          <item>Power On</item>
          <item>Turn On</item>
          <item>Turn On the TV</item>
        </one-of>
        <tag>out.command="PowerOn"</tag>
      </item>
      <item>
        <one-of>
          <item>Off</item>
          <item>Power Off</item>
          <item>Turn Off</item>
          <item>Turn Off the TV</item>
        </one-of>
        <tag>out.command="PowerOff"</tag>
      </item>
      <item>
        <one-of>
          <item>Select</item>
          <item>OK</item>
        </one-of>
        <tag>out.command="Select"</tag>
      </item>
      <item>
        <one-of>
          <item>TiVo</item>
          <item>Go to TiVo</item>
        </one-of>
        <tag>out.command="TiVo"</tag>
      </item>
      <item>
        <one-of>
          <item>Guide</item>
          <item>Go to Guide</item>
        </one-of>
        <tag>out.command="Guide"</tag>
      </item>
      <item>
        <one-of>
          <item>Netflix</item>
          <item>Go to Netflix</item>
        </one-of>
        <tag>out.command="Netflix"</tag>
      </item>
      <item>
        <one-of>
          <item>Play</item>
        </one-of>
        <tag>out.command="Play"</tag>
      </item>
      <item>
        <one-of>
          <item>Pause</item>
        </one-of>
        <tag>out.command="Pause"</tag>
      </item>
      <item>
        <one-of>
          <item>Record</item>
        </one-of>
        <tag>out.command="Record"</tag>
      </item>
      <item>
        <one-of>
          <item>Mute</item>
        </one-of>
        <tag>out.command="Mute"</tag>
      </item>
      <item>
        <one-of>
          <item>Exit</item>
          <item>Quit</item>
        </one-of>
        <tag>out.command="Exit"</tag>
      </item>
    </one-of>
  </rule>

  <rule id="RepeatableCommand">
    <one-of>
      <item>
        <one-of>
          <item>Up</item>
          <item>Go up</item>
        </one-of>
        <tag>out.command="Up"</tag>
      </item>
      <item>
        <one-of>
          <item>Down</item>
          <item>Go down</item>
        </one-of>
        <tag>out.command="Down"</tag>
      </item>
      <item>
        <one-of>
          <item>Left</item>
          <item>Go left</item>
        </one-of>
        <tag>out.command="Left"</tag>
      </item>
      <item>
        <one-of>
          <item>Right</item>
          <item>Go right</item>
        </one-of>
        <tag>out.command="Right"</tag>
      </item>
      <item>
        <one-of>
          <item>Back</item>
          <item>Go back</item>
        </one-of>
        <tag>out.command="Back"</tag>
      </item>
      <item>
        <one-of>
          <item>Replay</item>
          <item>Skip back</item>
        </one-of>
        <tag>out.command="Replay"</tag>
      </item>
      <item>
        <one-of>
          <item>Advance</item>
          <item>Skip forward</item>
          <item>Skip</item>
        </one-of>
        <tag>out.command="Skip"</tag>
      </item>
      <item>
        <one-of>
          <item>Channel up</item>
          <item>Page up</item>
        </one-of>
        <tag>out.command="ChannelUp"</tag>
      </item>
      <item>
        <one-of>
          <item>Channel down</item>
          <item>Page down</item>
        </one-of>
        <tag>out.command="ChannelDown"</tag>
      </item>
      <item>
        <one-of>
          <item>Louder</item>
          <item>Volume up</item>
        </one-of>
        <tag>out.command="VolumeUp"</tag>
      </item>
      <item>
        <one-of>
          <item>Quieter</item>
          <item>Softer</item>
          <item>Volume down</item>
        </one-of>
        <tag>out.command="VolumeDown"</tag>
      </item>
    </one-of>

    <ruleref uri="#RepeatCount" />
    <tag>out.repeat=rules.latest()</tag>
  </rule>

  <rule id="Stop">
    <one-of>
      <item>
        <one-of>
          <item>Stop Listening</item>
          <item>Done</item>
          <item>I'm Done</item>
        </one-of>
        <tag>out.system="STOPLISTENING"</tag>
      </item>
      <item>
        Thank you
        <tag>out={system:"STOPLISTENING",thankyou:true}</tag>
      </item>
    </one-of>
  </rule>

  <rule id="Typing">
    Type <ruleref uri="grammar:dictation" type="application/srgs+xml" />
  </rule>

  <rule id="RepeatCount">
    <one-of>
      <item>
        <one-of>
          <item></item>
          <item>once</item>
          <item>one</item>
          <item>one time</item>
        </one-of>
        <tag>out=1</tag>
      </item>
      <item>
        <one-of>
          <item>twice</item>
          <item>two</item>
          <item>two times</item>
        </one-of>
        <tag>out=2</tag>
      </item>
      <item>
        <one-of>
          <item>three</item>
          <item>three times</item>
        </one-of>
        <tag>out=3</tag>
      </item>
      <item>
        <one-of>
          <item>four</item>
          <item>four times</item>
        </one-of>
        <tag>out=4</tag>
      </item>
      <item>
        <one-of>
          <item>five</item>
          <item>five times</item>
        </one-of>
        <tag>out=5</tag>
      </item>
      <item>
        <one-of>
          <item>six</item>
          <item>six times</item>
        </one-of>
        <tag>out=6</tag>
      </item>
      <item>
        <one-of>
          <item>seven</item>
          <item>seven times</item>
        </one-of>
        <tag>out=7</tag>
      </item>
      <item>
        <one-of>
          <item>eight</item>
          <item>eight times</item>
        </one-of>
        <tag>out=8</tag>
      </item>
      <item>
        <one-of>
          <item>nine</item>
          <item>nine times</item>
        </one-of>
        <tag>out=9</tag>
      </item>
    </one-of>
  </rule>
</grammar>